{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climaflux-erp",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/unpack.mjs",
    "watch_dir": [
      ".bootstrap",
      "scripts"
    ]
  },
  "assets": {
    "directory": "./source",
    "not_found_handling": "single-page-application"
  }
}
